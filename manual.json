{
 "schema": "fieldwork/worked-example-manual/1",
 "example": "urn:fieldwork:example:sierra-leone-measles",
 "intro": "Each workflow reads the semi-synthetic line list from this repository, at a fixed commit. Start from an empty canvas: Project, then New project.",
 "workflows": [
  {
   "name": "How did the outbreak unfold, month by month?",
   "steps": [
    {
     "click": "#new-project",
     "label": "New project",
     "opens": "New project"
    },
    {
     "fill": "project-name-input",
     "label": "Name",
     "value": "Measles in Sierra Leone, 2019 to 2023",
     "dialog": "New project"
    },
    {
     "fill": "project-subject-input",
     "label": "Subject",
     "value": "A semi-synthetic measles line list made safe to teach with",
     "dialog": "New project"
    },
    {
     "click": "#project-create",
     "label": "Create project",
     "dialog": "New project"
    },
    {
     "fill": "workflow-name-edit",
     "view": "project",
     "label": "This workflow’s name — the question it answers",
     "value": "How did the outbreak unfold, month by month?"
    },
    {
     "note": "2,606 suspected measles cases notified in Sierra Leone, one row each. The file is semi-synthetic: whole records were swapped between cases of the same district and month, and every date moved by up to a week and set to its Monday. The curve keeps its shape; no row is a real person."
    },
    {
     "add": "table_input",
     "as": "cases"
    },
    {
     "select": "cases"
    },
    {
     "click": "#open-table",
     "label": "Configure…",
     "opens": "Tabular data"
    },
    {
     "click": "#table-remote summary",
     "label": "Or fetch from a URL",
     "dialog": "Tabular data"
    },
    {
     "fill": "table-url",
     "label": "URL of a CSV, Stata file or zip",
     "value": "https://raw.githubusercontent.com/digital-twin-ph/example-2019-sierra-leone-measles/3e5c7312d6e570ed1ec75d46689a5cf29f2a23d2/data/measles-sierra-leone-semisynthetic.csv",
     "dialog": "Tabular data"
    },
    {
     "click": "#table-fetch",
     "label": "Fetch",
     "dialog": "Tabular data"
    },
    {
     "choose": "table-shape",
     "label": "Shape of the file",
     "value": "long",
     "shown": "Long",
     "dialog": "Tabular data"
    },
    {
     "choose": "table-value",
     "label": "Value column",
     "value": "Age (years)",
     "dialog": "Tabular data"
    },
    {
     "click": "#table-keys-choose",
     "label": "Choose key columns…",
     "dialog": "Tabular data",
     "opens": "Key columns"
    },
    {
     "fill": "table-keys-paste",
     "label": "Columns to keep, pasted or typed",
     "value": "Case number, Organisation unit name, Residential District, Sex, Onset/Start date, Date seen at Health Facility/Community, LRS Specimen test 01 - result",
     "dialog": "Key columns"
    },
    {
     "click": "#table-keys-keep",
     "label": "Keep these",
     "dialog": "Key columns"
    },
    {
     "click": "#table-keys-done",
     "label": "Done",
     "dialog": "Key columns"
    },
    {
     "fill": "table-unit",
     "label": "Unit of the value (entered by you)",
     "value": "years",
     "dialog": "Tabular data"
    },
    {
     "click": "#table-save",
     "label": "Apply",
     "dialog": "Tabular data"
    },
    {
     "note": "Keep the cases whose onset falls in 2019 to 2023. Two onsets fall outside the visits’ span, in 2017 and 2025, and 389 cases have no onset at all. The step leaves them out and says how many: they are findings about the file, not cleaned away."
    },
    {
     "add": "select_rows",
     "as": "onset"
    },
    {
     "connect": {
      "from": "cases",
      "to": "onset",
      "port": "records"
     }
    },
    {
     "select": "onset"
    },
    {
     "click": "#configure-step",
     "label": "Configure…",
     "opens": "Select rows by value"
    },
    {
     "choose": "select-key",
     "label": "Key column to choose by",
     "value": "Onset/Start date",
     "dialog": "Select rows by value"
    },
    {
     "choose": "select-mode",
     "label": "Keep",
     "value": "range",
     "shown": "A range of dates",
     "dialog": "Select rows by value"
    },
    {
     "fill": "select-from",
     "label": "From",
     "value": "2019-01-01",
     "dialog": "Select rows by value"
    },
    {
     "fill": "select-to",
     "label": "To",
     "value": "2023-12-31",
     "dialog": "Select rows by value"
    },
    {
     "click": "#config-apply",
     "label": "Apply",
     "dialog": "Select rows by value"
    },
    {
     "note": "A line list has no count in it, so count its rows by the onset date."
    },
    {
     "add": "group_table",
     "as": "byOnset"
    },
    {
     "connect": {
      "from": "onset",
      "to": "byOnset",
      "port": "records"
     }
    },
    {
     "select": "byOnset"
    },
    {
     "click": "#configure-step",
     "label": "Configure…",
     "opens": "Total within groups"
    },
    {
     "tick": "group-keep",
     "label": "Key columns to keep",
     "values": [
      "Onset/Start date"
     ],
     "dialog": "Total within groups"
    },
    {
     "choose": "group-aggregate",
     "label": "Aggregate",
     "value": "count",
     "shown": "Count rows",
     "dialog": "Total within groups"
    },
    {
     "click": "#config-apply",
     "label": "Apply",
     "dialog": "Total within groups"
    },
    {
     "add": "case_series",
     "as": "weekly"
    },
    {
     "select": "weekly"
    },
    {
     "choose": "series-input",
     "label": "Records arrive as",
     "value": "table",
     "shown": "a table, each row a count"
    },
    {
     "connect": {
      "from": "byOnset",
      "to": "weekly",
      "port": "cases"
     }
    },
    {
     "select": "weekly"
    },
    {
     "fill": "series-date",
     "label": "Event date attribute",
     "value": "Onset/Start date"
    },
    {
     "choose": "series-kind",
     "label": "Which date is it?",
     "value": "onset"
    },
    {
     "note": "Five years is about 260 weeks, more than a chart here draws; count by month, as multi-year measles surveillance is usually shown. Every date in the file was set to a Monday, so a week starting Monday is the finer choice for one year."
    },
    {
     "choose": "series-period",
     "label": "Period",
     "value": "month",
     "shown": "month"
    },
    {
     "click": "#add-series-chart",
     "label": "Add epidemic curve",
     "as": "curve"
    },
    {
     "select": "curve"
    },
    {
     "fill": "chart-label",
     "label": "Results tab name",
     "value": "Epidemic curve"
    },
    {
     "fill": "chart-title",
     "label": "Chart title",
     "value": "Suspected measles cases by month of onset, Sierra Leone, 2019 to 2023"
    },
    {
     "fill": "chart-subtitle",
     "label": "Subtitle / context",
     "value": "Every notified suspected case with an onset date in 2019 to 2023. Semi-synthetic: each date moved by up to a week, so a case near a month boundary may sit in the next."
    },
    {
     "fill": "chart-x-axis",
     "label": "Horizontal axis label",
     "value": "Month of onset"
    },
    {
     "fill": "chart-source-note",
     "label": "Source / method note",
     "value": "Sierra Leone FETP line list, de-identified and made semi-synthetic for teaching (example-2019-sierra-leone-measles). Suspected cases, not confirmed ones."
    },
    {
     "run": true
    },
    {
     "see": "the curve rising through 2022 and peaking in 2023",
     "check": "Epidemic curve"
    }
   ]
  },
  {
